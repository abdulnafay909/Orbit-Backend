# Copy to .env for local development. Never commit real credentials.
PORT=5000
NODE_ENV=development

GEMINI_API_KEY=
GEMINI_STREAM_MODEL=gemini-2.5-flash
GEMINI_VISION_MODEL=gemini-2.5-flash
GEMINI_SEARCH_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENAI_API_KEY=
AI_PRIMARY_PROVIDER=gemini
AI_FALLBACK_PROVIDERS=groq

# Use DATABASE_URL for managed PostgreSQL, or the individual DATABASE_* variables below.
DATABASE_URL=
DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=

JWT_SECRET=
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=30

# Optional: Tavily is used when configured. Otherwise web search falls back to Gemini Google Search grounding.
TAVILY_API_KEY=
